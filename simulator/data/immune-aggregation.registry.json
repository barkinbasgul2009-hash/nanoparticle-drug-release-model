  "target_aliases": {
    "net_immune_effect": { "canonical": "immune_escape_overall", "reason": "the confidence-weighted overall escape aggregate was mislabelled with the net-effect target; renamed for semantic uniqueness. net_immune_effect is retained as a RESERVED Section-1 domain target.", "status": "resolved_rename", "note": "aggregation targets are internal only (never serialized / never in the contribution ledger), so no stored data references these ids and no replay migration is required." },
