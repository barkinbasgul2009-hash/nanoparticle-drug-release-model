  "conflict_resolution": {
    "policy": "explicit_no_silent_overwrite",
    "note": "When modules produce competing effects (e.g. high CD8 activity + high checkpoint pressure), the aggregator records BOTH as contributions and resolves them through the declared method; a later module never silently overwrites an earlier result. Conflicts are recorded as warnings on the aggregation result.",
    "conflict_flag_threshold": 0.5,
    "conflict_flag_threshold_note": "If opposing signed contributions each exceed this magnitude, a conflict warning is attached (schematic)."
  },
  "rules": {
