  "target_policy": {
    "unknown_target": "reject_before_evaluation",
    "unknown_target_note": "An aggregation target not declared above is a fatal error thrown BEFORE biological evaluation - there is NO silent availability_aware_average/[0,1] fallback for production targets.",
    "availability": "availability_aware: AVAILABLE only if all contributors available, PARTIALLY_AVAILABLE if some, UNAVAILABLE if none. Applies uniformly to every declared target.",
    "empty_input": "no contributions -> NOT_APPLICABLE; all contributors unavailable -> UNAVAILABLE. UNAVAILABLE is NEVER converted to 0.",
    "bounds": "every declared normalized target is [0,1]; methods that can exceed bounds are clamped to the declared min/max."
  },
