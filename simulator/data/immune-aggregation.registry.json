{
  "$schema_version": "1.0",
  "purpose": "Phase-7C shared aggregation framework registry (Part 1 - Section 2). Declares the aggregation METHODS available to every immune module and the DEFAULT method + bounds per aggregation target. No biological module implements its own aggregation - each declares a target here and calls the shared ImmuneAggregator. Availability, confidence, evidence, prediction, and contribution traceability are always preserved; unavailable inputs are never treated as zero. Deterministic (ordered contributor iteration).",
  "aggregation_framework_version": "7C.1.0",
  "methods": {
    "weighted_average":            { "description": "sum(w_i*v_i)/sum(w_i) over available inputs", "bounded": true },
    "weighted_sum":                { "description": "sum(w_i*v_i), then clamped to bounds", "bounded": true },
    "bounded_additive":            { "description": "clamp(sum(w_i*v_i), min, max)", "bounded": true },
    "bounded_multiplicative":      { "description": "product of (1 - w_i*v_i) style saturating combination, bounded", "bounded": true },
    "min_selector":                { "description": "minimum available input value", "bounded": true },
    "max_selector":                { "description": "maximum available input value", "bounded": true },
    "dominant_contributor":        { "description": "value of the largest weighted contribution", "bounded": true },
    "availability_aware_average":  { "description": "weighted average over AVAILABLE/PARTIALLY_AVAILABLE inputs only (Section-1 utility)", "bounded": true },
    "confidence_weighted_average": { "description": "weighted average with per-input confidence folded into the weight", "bounded": true }
  },
