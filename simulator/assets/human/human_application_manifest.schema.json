{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nanoparticle-drug-release-model/simulator/human_application_manifest.schema.json",
  "title": "Phase 2B human application manifest",
  "description": "Published contract for simulator/assets/human/human_application_manifest.json. The manifest is GENERATED by simulator/tools/blender/build_phase2_realism.py from the Blender scene: event timings come from EVT_* timeline markers, statistics from the exported meshes, and the clip block from the baked action. Nothing in it is hand-written. This document is the declarative form of the contract; simulator/src/three/applicationManifest.js is the executable form that runs at build time, test time and browser-load time (the repository ships no JSON Schema runtime, so the two are kept in step deliberately rather than by tooling).",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion", "assetVersion", "asset", "clip", "source", "skeleton",
    "objects", "morphTargets", "events", "ownership", "provenance", "compatibility", "statistics"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "assetVersion": { "type": "string", "minLength": 1 },
    "asset": {
      "type": "string",
      "description": "Runtime GLB, relative to this file. Must be local: no scheme, no leading slash.",
      "pattern": "^(?!/)(?![a-zA-Z]+:)[^\\s]+\\.glb$"
    },
    "generatedAtUtc": { "type": "string" },

    "clip": {
      "type": "object",
      "required": ["name", "fps", "durationSeconds", "frameStart", "frameEnd"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "frameStart": { "type": "integer" },
        "frameEnd": { "type": "integer" }
      },
      "description": "durationSeconds must equal (frameEnd - frameStart) / fps and must match the clip actually present in the GLB."
    },

    "source": {
      "type": "object",
      "required": ["originalAsset", "originalAssetChecksum", "blenderSource", "blenderVersion"],
      "properties": {
        "originalAsset": { "type": "string" },
        "originalAssetChecksum": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 of the immutable simulator/assets/human/human.glb at build time."
        },
        "blenderSource": { "type": "string" },
        "blenderVersion": { "type": "string" },
        "buildScript": { "type": "string" }
      }
    },

    "skeleton": {
      "type": "object",
      "required": ["boneMapVersion", "boneCount", "compatibilityStatus"],
      "properties": {
        "boneMapVersion": { "type": "string", "minLength": 1 },
        "boneCount": { "type": "integer", "exclusiveMinimum": 0 },
        "rootBone": { "type": "string" },
        "compatibilityStatus": { "const": "verified" }
      }
    },

    "objects": {
      "type": "object",
      "description": "Exported node names. Every value must resolve in the loaded GLB. nozzleAnchor and depositAnchor are empty marker nodes the Three.js camera tracks; they are runtime data, not authoring controls, and are the only non-geometry nodes in the export.",
      "required": [
        "humanRoot", "bodyMesh", "tube", "cap",
        "creamStrand", "creamDeposit", "creamSpread", "nozzleAnchor", "depositAnchor"
      ],
      "additionalProperties": { "type": "string", "minLength": 1 }
    },

    "morphTargets": {
      "type": "object",
      "description": "Semantic name -> the mesh that carries it and the exported morph names. Every name must exist on that mesh in the GLB.",
      "required": [
        "tubeSqueeze", "tubeDepletion", "skinIndent",
        "creamNozzle", "creamStrand", "creamDeposit", "creamSpread"
      ],
      "additionalProperties": {
        "type": "object",
        "required": ["mesh", "targets"],
        "properties": {
          "mesh": { "type": "string", "minLength": 1 },
          "targets": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },

    "events": {
      "type": "object",
      "description": "Normalized master progress, generated from EVT_* Blender timeline markers. Values must be in 0..1, must not decrease in storyboard order, neutral must be exactly 0 and sequenceEnd exactly 1.",
      "required": [
        "neutral", "productEstablishStart", "gripPreparation", "productGripEstablished",
        "dispensePreparation", "dispenseStart", "creamContact", "dispenseEnd",
        "productRetreatStart", "productRetreatEnd", "handApproach", "skinContact",
        "spreadStart", "strokeOne", "strokeTwo", "releaseStart", "releaseEnd",
        "heroStart", "heroHold", "sequenceEnd"
      ],
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 },
      "properties": {
        "neutral": { "const": 0 },
        "sequenceEnd": { "const": 1 }
      }
    },

    "ownership": {
      "type": "object",
      "description": "Exactly one system owns each channel. Two systems on the same channel is a Phase 2B blocking failure.",
      "required": ["bones", "morphTargets", "camera", "timeline", "surfaceShader"],
      "properties": {
        "bones": { "enum": ["blender-baked", "procedural"] },
        "morphTargets": { "enum": ["blender-baked", "procedural"] },
        "camera": { "const": "threejs" },
        "timeline": { "const": "master-progress" },
        "surfaceShader": { "const": "threejs-glsl" }
      }
    },

    "provenance": {
      "type": "object",
      "description": "Phase 2B motion, product, deformation and camera values are presentation, not science.",
      "required": ["humanMotion", "productMotion", "tubeSqueeze", "creamExtrusion", "skinIndentation", "camera"],
      "additionalProperties": { "enum": ["SIMULATION_DERIVED", "PREDICTED_VISUAL", "VISUAL_ONLY"] }
    },

    "compatibility": {
      "type": "object",
      "required": ["threeRevision", "gltf", "presentationModes"],
      "properties": {
        "threeRevision": { "type": "string", "minLength": 1 },
        "gltf": { "const": "2.0" },
        "presentationModes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["blender-baked", "procedural-fallback"] }
        }
      }
    },

    "statistics": {
      "type": "object",
      "required": [
        "fileSizeBytes", "meshCount", "triangleCount", "materialCount",
        "textureCount", "animationTrackCount", "morphTargetCount"
      ],
      "additionalProperties": { "type": "number", "minimum": 0 }
    }
  }
}
