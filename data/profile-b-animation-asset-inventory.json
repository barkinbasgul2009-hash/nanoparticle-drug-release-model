  "reuse_vs_build_summary": {
    "reuse": ["Z-Anatomy body (B2 context only)","3Dmol.js celastrol molecule (optional)","Lottie/Rive UI micro-animations (optional)"],
    "procedural": ["skin slab + depth bands","cells","organelles","labels","camera","lighting","transitions"],
    "dynamic": ["nanoparticles","release emission","uptake glow","effect cues","evidence overlays"],
    "rationale": "Profile-B V1 is mostly PROCEDURAL/DYNAMIC because the science is schematic (depth bands, ordinal uptake, qualitative release) - procedural assets stay self-contained (GitHub-Pages friendly), lightweight, and fully controllable by evidence gates. Heavy anatomical meshes are reused only where a systemic body frame adds orientation (B2)."
  },
  "licensing_rules": ["prefer permissive (BSD/MIT) or attribution (CC BY / CC BY-SA) assets","record attribution + share-alike obligations","keep the deployed page self-contained (inline/bundle assets; no external CDN at runtime, matching the existing tool's constraints)"]
